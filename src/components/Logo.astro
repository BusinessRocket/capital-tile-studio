---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <rect x="2" y="2" width="13" height="13" rx="2.5" fill="currentColor"></rect>
  <rect x="17" y="2" width="13" height="13" rx="2.5" fill="currentColor" opacity="0.35"></rect>
  <rect x="2" y="17" width="13" height="13" rx="2.5" fill="currentColor" opacity="0.35"></rect>
  <rect x="17" y="17" width="13" height="13" rx="2.5" fill="#8a6a35"></rect>
</svg>
