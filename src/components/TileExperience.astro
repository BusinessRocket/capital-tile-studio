---
import TileArt from './TileArt.astro';
import { site } from '../data/site';

const chapters = [
  {
    eyebrow: 'Floors',
    title: 'Floors, laid true.',
    body: 'Herringbone, large-format or classic grid. Every floor is set out before the first tile goes down, then laid flat, level and square.',
    link: { href: '/services/#floors', label: 'Floor tiling' },
    side: 'left',
  },
  {
    eyebrow: 'Walls',
    title: 'Walls that line up.',
    body: 'Bathrooms, showers and splashbacks with even joints from corner to corner, and cuts placed where you will never notice them.',
    link: { href: '/services/#bathrooms', label: 'Bathrooms & walls' },
    side: 'right',
  },
  {
    eyebrow: 'Feature walls',
    title: 'Character, built in.',
    body: 'Vertical stacks, finger tiles and statement colours. A feature wall that looks intentional, because it was planned that way.',
    link: { href: '/services/#walls', label: 'Feature walls' },
    side: 'left',
  },
];
---

<!-- Arrival: once per visit, pure CSS, never blocks interaction for long. -->
<script is:inline>
  try {
    if (sessionStorage.getItem('suite-arrived')) document.documentElement.classList.add('suite-arrived');
    sessionStorage.setItem('suite-arrived', '1');
  } catch {}
</script>
<div class="arrival" aria-hidden="true">
  <div class="arrival-mark">
    <span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span><span class="brass" style="--i:3"></span>
  </div>
  <p class="arrival-word">Capital Tile Studio</p>
  <p class="arrival-sub">Canberra</p>
</div>

<section class="xp relative" data-xp aria-label="Introduction">
  <div class="xp-stage sticky top-0 -mb-[100dvh] h-dvh overflow-hidden" aria-hidden="true">
    <div class="xp-fallback absolute inset-0 transition-opacity duration-1000">
      <TileArt pattern="herringbone" palette="marble" width={1600} height={1000} unit={56} seed={7} class="h-full w-full opacity-60" />
    </div>
    <canvas class="xp-canvas absolute inset-0 h-full w-full" data-xp-canvas></canvas>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-canvas to-transparent"></div>
  </div>

  <div class="relative z-10">
    <!-- Chapter 0: hero -->
    <div class="relative flex min-h-[100dvh] flex-col items-center justify-start px-5 pt-14 text-center md:items-start md:justify-end md:px-12 md:pb-16 md:text-left">
      <div class="xp-card max-w-xl rounded-[2rem] px-6 py-8 md:px-10 md:py-9">
        <p class="eyebrow rise">Canberra tiling</p>
        <h1 class="rise mt-3 text-[3.6rem] font-semibold md:text-[5.4rem]" style="--d:1">
          Tiling,<br class="sm:hidden" /> <em>perfected.</em>
        </h1>
        <p class="rise mx-auto mt-5 max-w-md text-lg leading-relaxed text-ink-soft md:mx-0 md:text-xl" style="--d:2">
          Bathrooms, floors, feature walls and outdoor areas, laid with precision. Floor tiling from ${site.rates.labour} per m².
        </p>
        <div class="rise mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 md:justify-start" style="--d:3">
          <a href="/contact/#quote" class="btn btn-primary btn-glass">Get a quote</a>
          <a href="/pricing/" class="link-arrow">See pricing</a>
        </div>
      </div>
      <p class="xp-hint mt-auto mb-24 flex flex-col items-center gap-2 text-sm font-medium text-ink-soft md:absolute md:right-12 md:bottom-16 md:mb-0">
        Scroll to build the room
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
      </p>
    </div>

    {
      chapters.map((c) => (
        <div class:list={['flex min-h-[130dvh] items-end px-4 pb-28 md:items-center md:px-12 md:pb-0', c.side === 'right' ? 'md:justify-end' : 'md:justify-start']}>
          <div class="xp-card mx-auto w-full max-w-md rounded-[1.75rem] p-6 md:mx-0 md:p-10" data-reveal>
            <p class="eyebrow">{c.eyebrow}</p>
            <h2 class="mt-2 text-3xl font-semibold leading-tight md:mt-3 md:text-5xl">{c.title}</h2>
            <p class="mt-3 leading-relaxed text-ink-soft md:mt-4 md:text-lg">{c.body}</p>
            <a href={c.link.href} class="link-arrow mt-4">
              {c.link.label}
            </a>
          </div>
        </div>
      ))
    }

    <!-- Final chapter: price reveal -->
    <div class="flex min-h-[130dvh] items-end justify-center px-4 pb-28 md:items-center md:pb-0">
      <div class="xp-card w-full max-w-xl rounded-[1.75rem] p-6 text-center md:p-12" data-reveal>
        <p class="eyebrow">Floor tiling</p>
        <h2 class="mt-2 text-3xl font-semibold md:mt-3 md:text-5xl">Premium finish.<br /><em>Honest price.</em></h2>
        <div class="mt-6 grid grid-cols-2 divide-x divide-line">
          <div class="px-2">
            <span class="block text-[3.25rem] leading-none font-semibold tracking-tighter tabular-nums md:text-[5.5rem]">${site.rates.labour}</span>
            <span class="mt-2 block text-sm text-ink-soft md:text-base">per m², labour only</span>
          </div>
          <div class="px-2">
            <span class="block text-[3.25rem] leading-none font-semibold tracking-tighter tabular-nums md:text-[5.5rem]">${site.rates.supplied}</span>
            <span class="mt-2 block text-sm text-ink-soft md:text-base">per m², tiles supplied</span>
          </div>
        </div>
        <p class="mt-5 leading-relaxed text-ink-soft">Confirmed with a written quote after we measure up.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-x-6 gap-y-3">
          <a href="/contact/#quote" class="btn btn-primary btn-glass">Get a quote</a>
          <a href="/pricing/#estimate" class="link-arrow">Estimate your job</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Showroom: try a floor finish live. Only shown once the 3D scene is running. -->
  <div class="xp-switch" data-xp-switch hidden>
    <div class="xp-card flex items-center gap-1 rounded-full p-1.5" role="group" aria-label="Try a floor finish">
      <span class="hidden px-3 text-sm font-medium text-ink-soft sm:inline">Try a floor</span>
      {
        [
          { id: 'marble', label: 'Marble', swatch: '#ece8e1' },
          { id: 'sage', label: 'Sage', swatch: '#9fac94' },
          { id: 'terracotta', label: 'Terracotta', swatch: '#c4714d' },
          { id: 'charcoal', label: 'Charcoal', swatch: '#3d3d40' },
        ].map((s, i) => (
          <button
            type="button"
            class="xp-chip"
            data-style={s.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="h-4 w-4 flex-none rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.12)]" style={`background:${s.swatch}`}></span>
            <span class="xp-chip-label">{s.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .arrival {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    background: var(--color-canvas);
    pointer-events: none;
    animation: arrival-out 0.6s var(--ease-out-soft) 1.05s forwards;
  }
  :global(.suite-arrived) .arrival {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .arrival {
      display: none;
    }
  }
  .arrival-mark {
    display: grid;
    grid-template-columns: repeat(2, 1.6rem);
    gap: 0.28rem;
  }
  .arrival-mark span {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.3rem;
    background: var(--color-ink);
    opacity: 0;
    animation: arrival-tile 0.5s var(--ease-out-soft) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  .arrival-mark span:nth-child(2),
  .arrival-mark span:nth-child(3) {
    background: rgb(28 27 25 / 0.32);
  }
  .arrival-mark .brass {
    background: linear-gradient(135deg, #d9bd85, #8a6a35);
  }
  .arrival-word {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0;
    animation: arrival-fade 0.6s var(--ease-out-soft) 0.38s forwards;
  }
  .arrival-sub {
    margin-top: -0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-bronze);
    opacity: 0;
    animation: arrival-fade 0.6s var(--ease-out-soft) 0.5s forwards;
  }
  @keyframes arrival-tile {
    from {
      opacity: 0;
      transform: translateY(10px) rotate(-8deg) scale(0.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes arrival-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes arrival-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .xp-card {
    background: rgb(253 252 250 / 0.74);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.35), inset 0 0 0 1px rgb(255 255 255 / 0.6);
  }
  .xp-canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-soft);
  }
  [data-xp-ready] .xp-canvas {
    opacity: 1;
  }
  [data-xp-ready] .xp-fallback {
    opacity: 0;
  }
  .xp-switch {
    position: fixed;
    left: 50%;
    top: 4.25rem;
    z-index: 30;
    max-width: calc(100vw - 1.5rem);
    transform: translate(-50%, -8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out-soft), transform 0.4s var(--ease-out-soft);
  }
  @media (min-width: 768px) {
    .xp-switch {
      top: auto;
      bottom: 1.5rem;
      transform: translate(-50%, 8px);
    }
  }
  .xp-switch[data-on] {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .xp-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0 0.85rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .xp-chip:hover {
    background: rgb(0 0 0 / 0.05);
  }
  .xp-chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: #fff;
  }
  /* Small phones: colour dots only, with the selected finish named. */
  @media (max-width: 430px) {
    .xp-chip {
      padding: 0 0.7rem;
      min-width: 44px;
      justify-content: center;
    }
    .xp-chip:not([aria-pressed='true']) .xp-chip-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .xp-hint svg {
      animation: nudge 1.8s ease-in-out infinite;
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-xp]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-xp-canvas]');

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const hasWebGL = (() => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  })();

  if (root && canvas && !reduce && !saveData && hasWebGL) {
    const progress = () => {
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      return total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
    };

    const load = async () => {
      try {
        const { createScene } = await import('../lib/scene');
        const scene = createScene(canvas, progress);
        root.setAttribute('data-xp-ready', '');

        let onScreen = true;
        const sync = () => (onScreen && document.visibilityState === 'visible' ? scene.start() : scene.stop());
        new IntersectionObserver(([e]) => {
          onScreen = e.isIntersecting;
          sync();
        }).observe(root);
        document.addEventListener('visibilitychange', sync);
        sync();

        // Floor switcher: visible while the floor is on screen.
        const sw = document.querySelector<HTMLElement>('[data-xp-switch]');
        if (sw) {
          sw.hidden = false;
          const chips = sw.querySelectorAll<HTMLButtonElement>('[data-style]');
          chips.forEach((chip) =>
            chip.addEventListener('click', () => {
              chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
              scene.setFloorStyle(chip.dataset.style as Parameters<typeof scene.setFloorStyle>[0]);
            }),
          );
          const showSwitch = () => {
            const p = progress();
            const r = root.getBoundingClientRect();
            const on = p > 0.28 && r.bottom > window.innerHeight * 0.6;
            sw.toggleAttribute('data-on', on);
            sw.inert = !on;
          };
          addEventListener('scroll', showSwitch, { passive: true });
          showSwitch();
        }
      } catch (err) {
        // The static fallback artwork stays visible if 3D fails for any reason.
        console.warn('3D scene unavailable', err);
      }
    };

    if ('requestIdleCallback' in window) requestIdleCallback(() => load(), { timeout: 1200 });
    else setTimeout(load, 200);
  }
</script>
