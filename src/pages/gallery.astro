---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoCard from '../components/PhotoCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos } from '../lib/gallery';
---

<Layout
  title="Gallery"
  description="Recent tiling jobs by Capital Tile Studio across Canberra: bathrooms, floors, feature walls, splashbacks and outdoor stonework."
>
  <PageHeader eyebrow="Gallery" title="Recent work." lead="A selection of recent jobs across Canberra." />

  <section class="container-x pb-10">
    <ul class="columns-1 gap-5 sm:columns-2 lg:columns-3">
      {
        photos.map((photo, i) => (
          <li class="mb-5 break-inside-avoid" data-reveal={i % 3}>
            <PhotoCard photo={photo} eager={i === 0} />
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title="Like what you see?" lead="Get in touch for a clear, written quote." />
</Layout>
