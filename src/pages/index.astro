---
import Layout from '../layouts/Layout.astro';
import TileArt from '../components/TileArt.astro';
import CtaBand from '../components/CtaBand.astro';
import TileExperience from '../components/TileExperience.astro';
import { services, site } from '../data/site';

const steps = [
  { n: '01', title: 'Get in touch', body: 'Call, text or send the quote form with a few details and photos of the space.' },
  { n: '02', title: 'Measure & quote', body: 'We look at the area, talk through tiles and layout, and give you a clear written quote.' },
  { n: '03', title: 'Set out & tile', body: 'Every layout is planned before the first tile goes down, then laid square, flat and true.' },
  { n: '04', title: 'Clean handover', body: 'Grout, silicone and a proper clean-up, so the room is ready to use.' },
];

const craft = [
  { title: 'Planned set-out', body: 'Cuts placed where they will not be seen. Lines that meet at the corners.' },
  { title: 'Flat and level', body: 'Floors and walls checked as we go, so tiles sit flush and edges stay crisp.' },
  { title: 'Tidy sites', body: 'We protect the areas around the job and clean up as we go.' },
];
---

<Layout
  title={`${site.name} | Premium Tiling in Canberra, floors from $${site.rates.labour}/m²`}
  description={`Canberra tilers for bathrooms, floors, feature walls, kitchen splashbacks and outdoor areas. Floor tiling from $${site.rates.labour} per m², or $${site.rates.supplied} per m² with tiles supplied. Call ${site.phone}.`}
>
  <TileExperience />

  <!-- Craft -->
  <section class="container-x py-20 md:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-semibold leading-tight md:text-6xl" data-reveal>Precision you can see.<br /><span class="text-stone">Quality you can feel.</span></h2>
    </div>
    <div class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-line md:mt-20 md:grid-cols-3">
      {
        craft.map((c, i) => (
          <div class="bg-canvas p-8 md:p-10" data-reveal={i}>
            <h3 class="text-xl font-semibold">{c.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{c.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="bg-mist py-20 md:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow" data-reveal>Services</p>
          <h2 class="mt-3 text-4xl font-semibold md:text-5xl" data-reveal="1">Every surface, done right.</h2>
        </div>
        <a href="/services/" class="link-arrow" data-reveal="2">All services</a>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li data-reveal={i % 3}>
              <a href={`/services/#${s.slug}`} class="card-lift group flex h-full flex-col overflow-hidden rounded-3xl bg-white">
                <div class="relative aspect-[16/10] overflow-hidden">
                  <TileArt
                    pattern={s.pattern}
                    palette={s.palette}
                    width={640}
                    height={400}
                    unit={s.pattern === 'hex' ? 30 : 38}
                    seed={i + 3}
                    class="h-full w-full transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-xl font-semibold">{s.title}</h3>
                  <p class="mt-2 flex-1 leading-relaxed text-ink-soft">{s.short}</p>
                  <span class="link-arrow mt-3">Learn more</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="on-dark bg-night py-20 text-white md:py-28">
    <div class="container-x">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 class="mt-3 max-w-2xl text-4xl font-semibold md:text-5xl" data-reveal="1">Simple from first call to final clean.</h2>
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s, i) => (
            <li data-reveal={i}>
              <span class="text-sm font-semibold text-bronze-light tabular-nums">{s.n}</span>
              <h3 class="mt-3 text-xl font-semibold">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-white/70">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Areas -->
  <section class="container-x py-20 md:py-28">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="eyebrow" data-reveal>Service area</p>
        <h2 class="mt-3 text-4xl font-semibold md:text-5xl" data-reveal="1">Local to Canberra.</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft" data-reveal="2">
          We tile homes right across Canberra and the surrounding region. Not sure if you are in range? Just ask.
        </p>
      </div>
      <ul class="flex flex-wrap gap-2" data-reveal="2">
        {site.areas.map((a) => <li class="rounded-full bg-mist px-4 py-2 text-sm font-medium text-ink-soft">{a}</li>)}
      </ul>
    </div>
  </section>

  {
    site.reviews.length > 0 && (
      <section class="bg-mist py-20 md:py-28">
        <div class="container-x">
          <h2 class="text-4xl font-semibold md:text-5xl">What clients say.</h2>
          <ul class="mt-12 grid gap-5 md:grid-cols-3">
            {site.reviews.map((r) => (
              <li class="rounded-3xl bg-white p-8">
                <blockquote class="text-lg leading-relaxed">“{r.text}”</blockquote>
                <p class="mt-4 text-sm text-stone">
                  {r.name}, {r.suburb}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</Layout>
