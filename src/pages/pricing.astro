---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Estimator from '../components/Estimator.tsx';
import { site } from '../data/site';

// TODO (owner): confirm what the per-m² rate includes and what is quoted separately.
const included = ['Setting out and laying floor and wall tiles', 'Standard grouting', 'Clean-up of the tiled area'];
const separate = [
  'Tiles, adhesive and grout supply',
  'Removing old tiles and disposal',
  'Floor levelling or screeding',
  'Waterproofing',
  'Mosaics and complex patterns such as herringbone',
];
---

<Layout
  title={`Tiling Prices Canberra: from $${site.rates.intro} per m²`}
  description={`Clear tiling prices in Canberra. Introductory rate of $${site.rates.intro} per m² for floor and wall tiling (standard $${site.rates.standard}/m²). Estimate your job online.`}
>
  <PageHeader
    eyebrow="Pricing"
    title="Clear pricing. No surprises."
    lead="One simple rate for floor and wall tiling, with a written quote before any work starts."
  />

  <section class="container-x pb-16 md:pb-24">
    <div class="grid gap-5 md:grid-cols-2">
      <div class="relative rounded-[2rem] bg-ink p-8 text-white md:p-12 on-dark" data-reveal>
        <span class="inline-flex rounded-full bg-bronze px-3 py-1 text-xs font-semibold uppercase tracking-wider">Introductory offer</span>
        <h2 class="mt-6 text-xl font-semibold">Floor & wall tiling</h2>
        <p class="mt-2 flex items-end gap-2">
          <span class="text-7xl font-semibold tracking-tighter tabular-nums">${site.rates.intro}</span>
          <span class="pb-2 text-lg text-white/70">per m²</span>
        </p>
        <p class="mt-4 leading-relaxed text-white/75">Our current introductory rate for standard floor and wall tiling.</p>
        <a href="/contact/#quote" class="btn btn-primary mt-8">Lock in this rate</a>
      </div>
      <div class="rounded-[2rem] bg-mist p-8 md:p-12" data-reveal="1">
        <span class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-wider text-stone">Standard rate</span>
        <h2 class="mt-6 text-xl font-semibold">Floor & wall tiling</h2>
        <p class="mt-2 flex items-end gap-2">
          <span class="text-7xl font-semibold tracking-tighter tabular-nums text-ink-soft">${site.rates.standard}</span>
          <span class="pb-2 text-lg text-stone">per m²</span>
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">The rate that applies once the introductory offer ends.</p>
      </div>
    </div>
  </section>

  <section id="estimate" class="scroll-mt-16 bg-mist py-20 md:py-28">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow" data-reveal>Estimator</p>
        <h2 class="mt-3 text-4xl font-semibold md:text-5xl" data-reveal="1">Estimate your job.</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft" data-reveal="2">
          A quick guide to the tiling cost at our introductory rate. Your final price comes from a written quote after we measure up.
        </p>
      </div>
      <div class="mt-12">
        <Estimator client:visible intro={site.rates.intro} standard={site.rates.standard} />
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-28">
    <h2 class="text-center text-4xl font-semibold md:text-5xl" data-reveal>What the rate covers.</h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <div class="rounded-[2rem] border border-line p-8 md:p-10" data-reveal>
        <h3 class="text-xl font-semibold">Included</h3>
        <ul class="mt-5 space-y-3">
          {
            included.map((t) => (
              <li class="flex items-start gap-3 text-ink-soft">
                <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 flex-none text-bronze" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-[2rem] border border-line p-8 md:p-10" data-reveal="1">
        <h3 class="text-xl font-semibold">Quoted separately</h3>
        <ul class="mt-5 space-y-3">
          {
            separate.map((t) => (
              <li class="flex items-start gap-3 text-ink-soft">
                <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 flex-none text-stone" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 10h10" /></svg>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-stone">
      Prices are in Australian dollars. Rates are a guide for standard tiles and layouts; every job is confirmed in a written quote.
    </p>
  </section>

  <CtaBand title="Get your exact price." lead="Send a few details and photos and we will put together a written quote." />
</Layout>
