---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="The page you are looking for could not be found.">
  <section class="container-x py-28 text-center md:py-40">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-5xl font-semibold md:text-7xl">This tile is missing.</h1>
    <p class="mx-auto mt-5 max-w-md text-lg text-ink-soft">The page you are looking for has moved or does not exist.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/contact/" class="link-arrow">Contact us</a>
    </div>
  </section>
</Layout>
